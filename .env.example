# Copie para .env.local e preencha. NUNCA coloque valores reais neste arquivo.
# Em produção, configure as variáveis no painel da Vercel.

# --- Supabase (Project Settings → API) ---
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_KEY=

# --- Autenticação do site ---
# Gere com: openssl rand -base64 48
JWT_SECRET=
# id (uuid) do plano que dá acesso ao painel /admin.html
ADMIN_PLANO_ID=

# --- URLs ---
PUBLIC_BASE_URL=https://www.transcreveia.com
# Origens permitidas no CORS (opcional; padrão: site + extensão do Chrome)
# ALLOWED_ORIGINS=https://www.transcreveia.com,https://transcreveia.com,chrome-extension://pgcllgiibjbikdcgbjepilfhaimcehpc

# --- IA (Groq) ---
GROQ_KEY=

# --- Mercado Pago ---
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# --- E-mail (Resend) ---
RESEND_API_KEY=
# destino dos e-mails de suporte enviados pelo Theo
SUPPORT_EMAIL=

# --- Google Calendar (OAuth) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://www.transcreveia.com/api/google/callback

# --- Vercel Cron (obrigatório: sem ele o job diário não roda) ---
# Gere com: openssl rand -hex 32
CRON_SECRET=
